{
  "realm": "olist",
  "enabled": true,
  "displayName": "SeekDateSet 数据分析工作台",
  "internationalizationEnabled": true,
  "supportedLocales": ["zh-CN", "en"],
  "defaultLocale": "zh-CN",
  "loginTheme": "olist",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "passwordPolicy": "length(10)",
  "smtpServer": {
    "from": "noreply@olist.local",
    "fromDisplayName": "SeekDateSet",
    "host": "mailpit",
    "port": "1025",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "olist-web",
      "name": "SeekDateSet Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "roles": {
    "realm": [
      {"name": "platform-user", "description": "Can use platform features"},
      {"name": "platform-admin", "description": "Can manage platform resources"}
    ]
  }
}
