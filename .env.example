MYSQL_ROOT_PASSWORD=local-only-change-me
MYSQL_USER=olist
MYSQL_PASSWORD=local-only-change-me

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-change-me

# Registration OTP configuration (Mailpit is used by default in Docker Compose).
KEYCLOAK_ADMIN_API_URL=http://localhost:8180
KEYCLOAK_REALM=olist
KEYCLOAK_REGISTRATION_CLIENT_ID=olist-registration-service
KEYCLOAK_REGISTRATION_CLIENT_SECRET=
REGISTRATION_OTP_SECRET=
REGISTRATION_CODE_TTL=10m
REGISTRATION_RESEND_DELAY=60s
REGISTRATION_VERIFIED_TOKEN_TTL=10m
REGISTRATION_IP_WINDOW=15m
REGISTRATION_MAX_CODES_PER_IP=10
REGISTRATION_MAX_CODE_ATTEMPTS=5

# Local Mailpit defaults; for QQ SMTP use smtp.qq.com:465 with SSL and auth enabled.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_SSL=false
SMTP_STARTTLS=false
SENDER_EMAIL=no-reply@seekdateset.local
SENDER_PASS=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
