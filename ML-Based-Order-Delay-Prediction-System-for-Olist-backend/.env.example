OLIST_SERVICE_NAME=model-serving
OLIST_MODEL_NAME=order-delay-model
OLIST_MODEL_ALIAS=Production
OLIST_MLFLOW_TRACKING_URI=http://localhost:5000
OLIST_OBJECT_STORE_ENDPOINT=http://localhost:4566
OLIST_OBJECT_STORE_BUCKET=olist-artifacts
OLIST_RULE_RUN_API_BASE_URL=http://localhost:8082
# Internal service token shared with dataset-service RULE_WORKER_INTERNAL_TOKEN.
OLIST_RULE_RUN_API_TOKEN=
OLIST_RULE_RUN_API_TIMEOUT_SECONDS=30
OLIST_RULE_EXECUTION_ENABLED=false
OLIST_CLICKHOUSE_HOST=localhost
OLIST_CLICKHOUSE_PORT=8123
OLIST_CLICKHOUSE_USERNAME=olist
OLIST_CLICKHOUSE_PASSWORD=
OLIST_CLICKHOUSE_SECURE=false
OLIST_RULE_PREVIEW_MAX_SAMPLE_ROWS=5000
OLIST_RULE_QUERY_MAX_ROWS_TO_READ=1000000
OLIST_RULE_QUERY_MAX_BYTES_TO_READ=268435456
OLIST_RULE_QUERY_MAX_EXECUTION_TIME_SECONDS=30
# Internal training token shared with model-management-service and dataset-service.
OLIST_MODEL_TRAINING_INTERNAL_TOKEN=
OLIST_DATASET_SERVICE_URL=http://localhost:8082
OLIST_MODEL_TRAINING_DATASET_TIMEOUT_SECONDS=120
OLIST_MODEL_ARTIFACT_DIRECTORY=./data/models
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
