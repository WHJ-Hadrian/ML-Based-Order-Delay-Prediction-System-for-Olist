MYSQL_ROOT_PASSWORD=local-only-change-me
MYSQL_USER=olist
MYSQL_PASSWORD=local-only-change-me

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-change-me

# Local development only: the local Keycloak URL enables password grant automatically.
# Set false explicitly outside a trusted local machine; production must use Authorization Code + PKCE.
# KEYCLOAK_ALLOW_PASSWORD_GRANT=true
# Registration OTP configuration (Mailpit is used by default in Docker Compose).
# These defaults are for local development only and must be replaced outside a trusted machine.
# Keep secrets empty in this template; place generated values in the untracked root .env file.
KEYCLOAK_ADMIN_API_URL=http://localhost:8180
KEYCLOAK_REALM=olist
KEYCLOAK_REGISTRATION_CLIENT_ID=olist-registration-service
KEYCLOAK_REGISTRATION_CLIENT_SECRET=
REGISTRATION_OTP_SECRET=
REGISTRATION_CODE_TTL=10m
REGISTRATION_RESEND_DELAY=60s
REGISTRATION_VERIFIED_TOKEN_TTL=10m
REGISTRATION_IP_WINDOW=15m
REGISTRATION_MAX_CODES_PER_IP=10
REGISTRATION_MAX_CODE_ATTEMPTS=5

# Local Mailpit defaults; for QQ SMTP use smtp.qq.com:465 with SSL and auth enabled.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_SSL=false
SMTP_STARTTLS=false
SENDER_EMAIL=no-reply@seekdateset.local
SENDER_PASS=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me

# ClickHouse (dataset-service READY import)
CLICKHOUSE_ENABLED=true
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123?compress=0
CLICKHOUSE_DATABASE=olist_datasets
CLICKHOUSE_USER=olist
CLICKHOUSE_PASSWORD=local-clickhouse-only
